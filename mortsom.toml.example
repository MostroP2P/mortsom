# mortsom.toml -- committed, non-secret baseline (spec §16.1).
#
# Copy to `mortsom.toml` (gitignored) or layer overrides in
# `mortsom.local.toml` (gitignored). Every secret is an `env:` reference; the
# loader lists all missing variables at once and refuses to start anything
# until they are present. Secrets never live in TOML -- not even in the
# gitignored overlay: wallet URIs and the daemon settings path are accepted
# only as `env:` references.

[mobile]
profile = "mobile-legacy"        # mobile-legacy | mobile-v2
source_dir = "../mobile"
flavor = "mortsom"
apk_path = ""                     # empty means build from source_dir
mostro_pubkey = "env:MORTSOM_MOSTRO_PUBKEY"
dart_defines = ["MOSTRO_PUB_KEY=${MORTSOM_MOSTRO_PUBKEY}"]
package = "network.mostro.app"    # application id of the build under test
main_activity = ""                # empty: UiAutomator2 resolves the launcher activity

[android]
avd_image = "system-images;android-35;google_apis;x86_64"
device_profile = "pixel_6"           # avdmanager device id (see `avdmanager list device -c`)
api_level = 35
boot_timeout_secs = 180
ui_timeout_secs = 30
snapshot_name = "mortsom-clean"
avd_name_prefix = "mortsom"       # AVDs are <prefix>-alice and <prefix>-bob
base_console_port = 5554          # alice 5554/5555, bob 5556/5557
emulator_ram_mb = 3072
headless = true
appium_port = 4723
base_system_port = 8200           # UiAutomator2 systemPort per actor: 8200, 8201

[relay]
docker_image = "scsibug/nostr-rs-relay:latest"
container_name_prefix = "mortsom-relay"
host_port = 7000                  # first port tried; each run allocates a free one
container_port = 8080

[mostro]
mode = "external_local"           # a locally managed Mostro daemon; never restarted by Mortsom
settings_file = "env:MORTSOM_MOSTRO_SETTINGS_FILE"
health_timeout_secs = 60
relays = ["ws://host.docker.internal:7000"]

[wallets]
# Each actor names its own backend. `nwc` is the app's own wallet, configured
# through its settings UI; `lnd` is a node Mortsom holds, which is how a local
# Polar network is driven (see config/polar.example.toml and the README).
# The two are alternatives: naming a field from the other kind is an error,
# not a line that is quietly ignored.

[wallets.alice]
kind = "nwc"
uri = "env:MORTSOM_ALICE_NWC"

[wallets.bob]
kind = "nwc"
uri = "env:MORTSOM_BOB_NWC"

[run]
lane = "local"                    # local | ci | canary -- always explicit, never inferred
amount_sats = 1000
max_order_sats = 5000
max_run_spend_sats = 20000
jobs = 1
artifacts_dir = "./artifacts"
cleanup = true
allow_mainnet = false             # value-moving scenarios also need MORTSOM_MAINNET_CONFIRM
infra_retries = 1                 # only classified infrastructure failures retry, at most once
fiat_code = "USD"                 # order drafts
fiat_amount = 1
payment_method = "cash"
state_timeout_secs = 180          # order state must appear on both apps and the relay
settle_timeout_secs = 600         # payment settlement deadline
expiration_timeout_secs = 1200   # daemon expiration_seconds (900) plus grace
quiet_window_secs = 20            # recovery: no repeated protocol action within this window
background_secs = 15              # recovery: time an app spends in the background
outage_secs = 20                  # recovery: injected connectivity outage
